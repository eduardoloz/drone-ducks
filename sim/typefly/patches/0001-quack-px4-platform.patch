+"""PX4 drone platform (PX4 SITL + Gazebo, or a real Pixhawk) for TypeFly.
+
+Implemented in ProjectQuack's `quackdrone` package (github.com/eduardoloz/drone-ducks, sim/): this
+shim only re-exports it, so the flight code is shared with ProjectQuack's tests and perception demos.
+Install it into TypeFly's venv with:  pip install -e <drone-ducks>/sim
+"""
+from quackdrone.integrations.typefly_px4 import PX4Observation, PX4Wrapper  # noqa: F401
diff --git a/typefly/serving/yolo_service.py b/typefly/serving/yolo_service.py
index e657acf..6c386f3 100644
--- a/typefly/serving/yolo_service.py
+++ b/typefly/serving/yolo_service.py
@@ -1,4 +1,4 @@
-import sys, os
+import sys, os, platform
 from concurrent import futures
 from PIL import Image
 from io import BytesIO
@@ -15,19 +15,29 @@ import hyrch_serving_pb2
 import hyrch_serving_pb2_grpc
 
 MODEL_PATH = os.path.join(PROJ_DIR, "./serving/models/")
-MODEL_TYPE = "yolo26s.pt"
+# TYPEFLY_YOLO_MODEL=yolo26n.pt is ~3x faster on CPU-only machines (e.g. Intel Macs).
+MODEL_TYPE = os.environ.get("TYPEFLY_YOLO_MODEL", "yolo26s.pt")
 
 def load_model():
     target = os.path.join(MODEL_PATH, MODEL_TYPE)
     if not os.path.exists(target):
         print(f"[typefly] First run: downloading YOLO weights {MODEL_TYPE} (~50MB), this may take a minute ...")
     model = YOLO(target)
-    if torch.cuda.is_available():
-        model.to('cuda')
-        print(f"GPU memory usage: {torch.cuda.memory_allocated()}")
-    elif torch.backends.mps.is_available():
-        model.to('mps')
-        print(f"MPS memory usage: {torch.mps.current_allocated_memory()}")
+    # TYPEFLY_YOLO_DEVICE=cpu|cuda|mps overrides auto-selection.
+    device = os.environ.get("TYPEFLY_YOLO_DEVICE")
+    if device is None:
+        if torch.cuda.is_available():
+            device = 'cuda'
+        # MPS only on Apple Silicon: Intel Macs with AMD GPUs report MPS as available, but
+        # torch 2.2.2 (the last x86_64 macOS wheel) lacks torchvision::nms on MPS -> every
+        # detection request fails.
+        elif torch.backends.mps.is_available() and platform.machine() == 'arm64':
+            device = 'mps'
+        else:
+            device = 'cpu'
+    if device != 'cpu':
+        model.to(device)
+    print(f"[typefly] YOLO {MODEL_TYPE} on {device}")
     
     return model
 
