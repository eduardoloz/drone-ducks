<?xml version="1.0" encoding="UTF-8"?>
<!-- Like PX4's mono_cam, but cheap to render: the stock 1280x960 @ 30 Hz camera drops Gazebo to
     ~0.2x real time on an Intel Mac, which makes PX4 SITL sluggish and unstable. -->
<sdf version="1.9">
  <model name="quack_cam">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <mass>0.050</mass>
        <inertia><ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00004</iyy><iyz>0</iyz><izz>0.00004</izz></inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
      </visual>
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0.14 0</pose>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>300</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
